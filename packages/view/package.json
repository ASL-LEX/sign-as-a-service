{
  "name": "@bu-sail/saas-view",
  "private": false,
  "version": "0.0.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run introspection && tsc && vite build",
    "prettier": "prettier -l \"src/**/*.ts(x)\"",
    "prettier:fix": "prettier -wl \"src/**/*.ts(x)\"",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "introspection": "graphql-codegen --config graphql-codegen.yml"
  },
  "dependencies": {
    "@mui/icons-material": "^5.14.14",
    "axios": "^1.5.1",
    "prettier": "^3.0.3",
    "vite-plugin-dts": "^3.5.3",
    "@apollo/client": "^3.8.1",
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/material": "^5.14.7",
    "graphql": "^16.8.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^5.0.0",
    "@graphql-codegen/client-preset": "^4.1.0",
    "@graphql-codegen/near-operation-file-preset": "^2.5.0",
    "@graphql-codegen/typescript-react-apollo": "^3.3.7",
    "@storybook/addon-essentials": "^8.6.19",
    "@storybook/addon-interactions": "^8.6.19",
    "@storybook/addon-links": "^8.6.19",
    "@storybook/addon-onboarding": "^8.6.19",
    "@storybook/blocks": "^8.6.19",
    "@storybook/react": "^8.6.19",
    "@storybook/react-vite": "^8.6.19",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "eslint": "^8.45.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "eslint-plugin-storybook": "^0.12.0",
    "storybook": "^8.6.19",
    "typescript": "^5.0.2",
    "vite": "^5.4.8"
  },
  "main": "./dist/saas.umd.js",
  "module": "./dist/saas.es.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/saas.es.js",
      "require": "./dist/saas.umd.js",
      "types": "./dist/index.d.ts"
    }
  }
}
